# Server options
PORT=3000
NODE_ENV=development
COOKIE_SECRET=replace_with_a_random_cookie_secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Prisma connection string
DATABASE_URL="postgresql://app_user:replace_with_a_strong_database_password@postgres:5432/app?schema=public"

# SMTP email configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=replace_with_your_smtp_app_password
SMTP_FROM=your_email@example.com

# OTP
OTP_SECRET=replace_with_a_random_64_character_hex_secret

# JWT authentication
JWT_ACCESS_SECRET=replace_with_a_random_access_jwt_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_jwt_secret

# Authentication cookie configuration
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
